	local function buildEnhanceSlot(slotName)
		if slotName ~= "weapon" then
			return { slot = slotName, locked = true, empty = true }
		end
		local itemId = AutoFarm.equipment and AutoFarm.equipment.weapon
		if type(itemId) ~= "string" or itemId == "" then
			return { slot = "weapon", locked = false, empty = true }
		end
		local def = ItemDefs[itemId]
		local cfg = EnhanceConfig
		local level = 0
		if type(AutoFarm.enhance) == "table" then
			level = math.max(0, math.floor(tonumber(AutoFarm.enhance[itemId]) or 0))
		end
		local maxLv = (cfg and tonumber(cfg.MAX_LEVEL)) or 99
		local maxed = level >= maxLv
		local step = 1
		local baseAtk = def and tonumber(def.attackPower) or 0
		local price = def and tonumber(def.price) or 0
		local atkNow, atkNext = baseAtk, baseAtk
		local goldCost, woodCost, crystalCost = 0, 0, 0
		local chance, destroy = 1, 0
		if cfg then
			pcall(function()
				step = cfg.stepOf(itemId) or 1
				atkNow = baseAtk + (cfg.attackBonus(step, level, baseAtk) or 0)
				local nextLv = math.min(level + 1, maxLv)
				atkNext = baseAtk + (cfg.attackBonus(step, nextLv, baseAtk) or 0)
				if not maxed then
					goldCost = cfg.goldCost(price, nextLv) or 0
					woodCost = cfg.woodCost(nextLv) or 0
					crystalCost = cfg.crystalCost(nextLv, step) or 0
					chance = cfg.successRate(nextLv) or 1
					destroy = cfg.destroyChance(step, level) or 0
				end
			end)
		end
		return {
			slot = "weapon",
			locked = false,
			empty = false,
			itemId = itemId,
			nameKey = (def and def.nameKey) or ("item." .. itemId .. ".name"),
			rarity = def and def.rarity or nil,
			level = level,
			maxed = maxed,
			atkNow = atkNow,
			atkNext = atkNext,
			gold = goldCost,
			wood = woodCost,
			crystal = crystalCost,
			chance = chance,
			destroy = destroy,
		}
	end

	local function buildEnhanceState()
		local woodId = (EnhanceConfig and EnhanceConfig.WOOD_ITEM_ID) or "wood"
		local crystalId = (EnhanceConfig and EnhanceConfig.CRYSTAL_ITEM_ID) or "crystal"
		return {
			ok = true,
			selected = "weapon",
			goldHave = getPlayerGold(),
			woodHave = tonumber(AutoFarm.inventory[woodId]) or 0,
			crystalHave = tonumber(AutoFarm.inventory[crystalId]) or 0,
			protectHave = math.max(0, math.floor(tonumber(LocalPlayer:GetAttribute("EnhanceProtect")) or 0)),
			slots = {
				buildEnhanceSlot("weapon"),
				buildEnhanceSlot("armor"),
				buildEnhanceSlot("accessory"),
				buildEnhanceSlot("shoes"),
			},
		}
	end

	local function openEnhanceUi()
		local state = nil
		local okInv, result = pcall(function()
			return getRemote("e61c8a7", "RemoteFunction"):InvokeServer({ action = "open" })
		end)
		if okInv and type(result) == "table" then
			if type(result.state) == "table" and (result.state.ok == true or type(result.state.slots) == "table") then
				state = result.state
			elseif result.ok == true or type(result.slots) == "table" then
				state = result
			end
		end
		if not state then
			state = buildEnhanceState()
		end
		local okOpen = fireClientRemote("e9f24b1", state)
		AutoFarm.statusText = okOpen and "강화 UI 열림" or "강화 UI 실패 (리모트)"
	end

	uiAdd("etc.shop", function()
		assert(EtcTab, "EtcTab nil")
		addAction(EtcTab, "상점 UI 열기", function()
			openBuyShopUi()
		end)
	end)

	uiAdd("etc.sell", function()
		assert(EtcTab, "EtcTab nil")
		addAction(EtcTab, "판매 UI 열기", function()
			openSellShopUi()
		end)
	end)

	uiAdd("etc.enhance", function()
		assert(EtcTab, "EtcTab nil")
		addAction(EtcTab, "강화 UI 열기", function()
			openEnhanceUi()
		end)
	end)

	-- 시작 시 팜은 항상 OFF (이전 세션/유령 루프 방지)
	stopAllFarm(nil)
	AutoFarm.statusText = "켜짐 - 물가 낚시자리 대기"

	print("[Star Hub] 로드 완료")
end)

if not ok then
	err(tostring(uiErr))
	print("[Star Hub] 상세:", uiErr)
end
