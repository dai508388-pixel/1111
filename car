local function pickDuelInviteTarget()
	local ok, result = pcall(function()
		return getRemote("ed68060", "RemoteFunction"):InvokeServer({
			action = "list",
		})
	end)
	if not ok or type(result) ~= "table" or result.ok ~= true then
		local code = type(result) == "table" and tostring(result.code or "list_fail") or "list_fail"
		return nil, code
	end
	local payload = result.payload
	if type(payload) ~= "table" or type(payload.players) ~= "table" then
		return nil, "no_players"
	end

	local hrp = getChar()
	local bestRow, bestD = nil, math.huge
	for _, row in pairs(payload.players) do
		if type(row) == "table" and row.canInvite == true then
			local uid = tonumber(row.userId)
			if uid and uid ~= LocalPlayer.UserId then
				local d = math.huge
				local plr = Players:GetPlayerByUserId(uid)
				local th = plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				if hrp and th then
					d = (th.Position - hrp.Position).Magnitude
				end
				if d < bestD then
					bestRow, bestD = row, d
				end
			end
		end
	end
	if not bestRow then
		return nil, "no_inviteable"
	end
	return bestRow, nil
end

