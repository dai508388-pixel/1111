local function hashName(seed, logicalId)
	local s = seed .. "|" .. logicalId .. "|"
	local h1, h2 = 5381, 52711
	for i = 1, #s do
		local b = string.byte(s, i)
		h1 = (h1 * 33 + b) % 4294967296
		h2 = (h2 * 31 + b) % 4294967296
	end
	return string.format("R%08x%08x", h1, h2)
end

local RemotesFolder
local RemoteSeed
local RemoteCache = {}

local function waitBoot()
	if not game:IsLoaded() then
		game.Loaded:Wait()
	end
	if workspace:GetAttribute("ServerBootDone") ~= true then
		workspace:GetAttributeChangedSignal("ServerBootDone"):Wait()
	end
	local shared = ReplicatedStorage:WaitForChild("Shared", 60)
	RemotesFolder = shared:WaitForChild("Remotes", 60)
	local t0 = os.clock()
	while not RemoteSeed and os.clock() - t0 < 30 do
		RemoteSeed = RemotesFolder:GetAttribute("__s")
		if not RemoteSeed then
			task.wait(0.1)
		end
	end
	if not RemoteSeed then
		error("서버 부팅 대기 시간 초과")
	end
	task.wait(0.2)
end

local function getRemote(logicalId, className)
	if RemoteCache[logicalId] then
		return RemoteCache[logicalId]
	end
	local name = hashName(RemoteSeed, logicalId)
	local inst = RemotesFolder:WaitForChild(name, 15)
	if not inst or not inst:IsA(className) then
		error("Remote 없음: " .. logicalId)
	end
	RemoteCache[logicalId] = inst
	return inst
end

