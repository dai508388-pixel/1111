hubConnect(RunService.RenderStepped, function()
	local hunting = AutoFarm.enabled == true
	local logging = AutoFarm.autoLog == true
	local mining = AutoFarm.autoDungeon == true
	local fishing = AutoFarm.autoFish == true
	local farm2On = Farm2.enabled == true
	local questing = AutoFarm.autoQuest == true
	-- 사냥/오토팜2 OFF면 절대 몹 공격·호버 금지 (힐/스킬만 켜져 있어도 팜 안 함)
	if not hunting and not farm2On then
		if AutoFarm.currentTarget or AutoFarm.dungeonTarget or Farm2.target then
			local _, hum = getChar()
			if hum then
				AutoFarm.resetMovement(hum)
			end
			AutoFarm.clearTarget()
			AutoFarm.dungeonTarget = nil
			Farm2.target = nil
		end
	end

	local skillsOn = false
	for i = 1, 4 do
		if AutoFarm.autoSkill[i] then
			skillsOn = true
			break
		end
	end

	local pvpOn = PvpMods.autoKill == true
	if not hunting and not logging and not mining and not fishing and not farm2On and not skillsOn and not AutoFarm.autoHeal and not AutoFarm.autoSell and not pvpOn and not questing then
		if AutoFarm.currentTarget or AutoFarm.logTarget or AutoFarm.mineTarget or AutoFarm.dungeonTarget or Farm2.target then
			local _, hum = getChar()
			if hum then
				AutoFarm.resetMovement(hum)
			end
			AutoFarm.clearTarget()
			AutoFarm.logTarget = nil
			AutoFarm.mineTarget = nil
			AutoFarm.dungeonTarget = nil
			Farm2.target = nil
		end
		clearQuestHuntState()
		return
	end

	local hrp, hum = getChar()
	if not hrp then
		AutoFarm.statusText = "캐릭터 없음"
		return
	end

	-- 자동 퀘스트: 수락/반납 우선 (팜보다 먼저). hunt 모드는 false로 양보
	if questing then
		if AutoFarm.tryQuest() then
			return
		end
	end

	-- 오토팜 2 우선 (고정 스팟 파밍)
	if farm2On then
		if Farm2.tick() then
			return
		end
	end

	if not farm2On then
		AutoFarm.tryHeal(hum)
		AutoFarm.trySkills()
	end

	-- 낚시 중에는 미니게임/자리 우선 (호버로 프롬프트 끊김 방지)
	if fishing then
		if AutoFarm.tryFish() then
			return
		end
	end

	-- 벌목 우선 (사냥과 동시에 켜도 나무부터)
	if logging then
		if AutoFarm.tryChopTree() then
			return
		end
	end

	-- 자동 던전
	if mining then
		if AutoFarm.tryDungeonClear() then
			return
		end
	end

	-- 자동 판매
	if AutoFarm.autoSell then
		AutoFarm.tryAutoSell()
	end

	-- PVP (사냥보다 우선 가능)
	if PvpMods.autoKill then
		if AutoFarm.tryPvp() then
			return
		end
	end

	if hunting and not farm2On then
		local target = AutoFarm.currentTarget
		local selectionChanged = AutoFarm.boundSelectionGen ~= AutoFarm.selectionGen
		if selectionChanged or not isValidHuntTarget(target) then
			local old = target
			target = AutoFarm.findTarget(old)
			if not target and old and not isValidHuntTarget(old) then
				target = AutoFarm.findTarget(nil)
			end
			AutoFarm.bindTarget(target)
			AutoFarm.boundSelectionGen = AutoFarm.selectionGen
		end

		if target and isValidHuntTarget(target) then
			AutoFarm.floatAbove(hrp, hum, target)
		else
			target = ensureHuntMobInRange(hrp, target)
		end
		if not target then
			target = AutoFarm.findTarget(nil)
			AutoFarm.bindTarget(target)
		end

		if target then
			AutoFarm.floatAbove(hrp, hum, target)
			AutoFarm.tryAttack(target)
			return
		end
		AutoFarm.statusText = logging and "나무/몹 없음" or "사냥할 몹 없음 (로딩 대기)"
		return
	end

	if logging then
		local folder = getDecorTreesFolder()
		AutoFarm.statusText = folder and "Trees 안 벌목 가능 나무 없음" or "Decorations/Trees 없음"
		AutoFarm.resetMovement(hum)
	end
end)

