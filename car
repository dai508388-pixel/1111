	if not pg then
		return false
	end
	for _, gui in pg:GetDescendants() do
		if (gui:IsA("TextButton") or gui:IsA("ImageButton")) and gui.Visible then
			local text = ""
			pcall(function()
				text = tostring(gui.Text or "")
			end)
			local path = string.lower(gui:GetFullName())
			local hit = text:find("입장", 1, true)
				or text:find("Enter", 1, true)
				or text:find("수락", 1, true)
			local dungeonish = path:find("dungeon", 1, true)
				or path:find("undercave", 1, true)
				or path:find("cave", 1, true)
				or text:find("던전", 1, true)
			if hit and dungeonish then
				fireGuiClick(gui)
				return true
			end
		end
