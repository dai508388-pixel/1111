local function itemDisplayName(itemId)
	return SELL_ITEM_FALLBACK[itemId] or itemId
end

local function isSellExcluded(itemId)
	if SELL_EXCLUDE[itemId] then
		return true
	end
	-- 요리(food_) 전부 제외
	if string.sub(itemId, 1, 5) == "food_" then
		return true
	end
	return false
end

local function getSellableItemEntries()
	-- 드롭/재료 위주 고정 목록만 (요리·특수템 제외)
	local rows = {}
	local seen = {}
	for id, label in pairs(SELL_ITEM_FALLBACK) do
		if not isSellExcluded(id) then
			seen[id] = true
			table.insert(rows, { id = id, label = label, price = 0 })
		end
	end
	for _, def in pairs(ItemDefs) do
		if type(def) == "table" and type(def.itemId) == "string" then
			local id = def.itemId
			if not seen[id] and not isSellExcluded(id) then
				local price = tonumber(def.sellPrice) or 0
				-- 재료만 추가 (consumable/요리는 제외)
				if price > 0 and def.category == "material" then
					seen[id] = true
					table.insert(rows, {
						id = id,
						label = itemDisplayName(id),
						price = price,
					})
				end
			end
		end
	end
	table.sort(rows, function(a, b)
		return a.label < b.label
	end)
	return rows
end

local function applySellSelection(sel)
	AutoFarm.sellItems = {}
	local function add(raw)
		local id = tostring(raw or "")
		if id ~= "" then
			-- "이름 (id)" 형태
			local paren = string.match(id, "%(([%w_]+)%)%s*$")
			AutoFarm.sellItems[paren or id] = true
			-- 라벨만 온 경우
			for _, e in ipairs(getSellableItemEntries()) do
				if e.label == id then
					AutoFarm.sellItems[e.id] = true
				end
			end
		end
	end
	if type(sel) == "string" then
		add(sel)
	elseif type(sel) == "table" then
		if sel[1] ~= nil then
			for _, v in ipairs(sel) do
				add(type(v) == "table" and (v.Title or v.Value) or v)
			end
		else
			for k, v in pairs(sel) do
				if v == true or v == 1 then
					add(k)
				elseif type(v) == "string" then
					add(v)
				elseif type(v) == "table" then
					add(v.Title or v.Value)
				end
			end
		end
	end
end

function AutoFarm.tryAutoSell()
	if not AutoFarm.autoSell then
		return
	end
	if not next(AutoFarm.sellItems) then
		return
	end
	local now = os.clock()
	if now - AutoFarm.lastSell < 1.5 then
		return
	end
	AutoFarm.lastSell = now
	local sold = 0
	for itemId in pairs(AutoFarm.sellItems) do
		local qty = tonumber(AutoFarm.inventory[itemId]) or 0
		-- 인벤 동기화 전이어도 서버에 시도 (없으면 거부)
		if qty > 0 or not next(AutoFarm.inventory) then
