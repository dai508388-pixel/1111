local function tpInsideUndercaveIfLoaded()
	local und = workspace:FindFirstChild("Undercave")
	if not und then
		return false
	end
	local entry = und:FindFirstChild("EntrySpots")
	local r1 = entry and entry:FindFirstChild("R1")
	if r1 then
		return tpToInstance(r1, Vector3.new(0, 5, 0))
	end
	local rooms = und:FindFirstChild("Rooms")
	local room1 = rooms and (rooms:FindFirstChild("Room1") or rooms:FindFirstChild("Room01") or rooms:FindFirstChildWhichIsA("Model"))
	if room1 then
		local spots = room1:FindFirstChild("MineralSpots")
		if spots then
			local m = spots:FindFirstChildWhichIsA("Model", true)
			if m then
				return tpToInstance(m, Vector3.new(0, 4, 4))
			end
		end
		return tpToInstance(room1, Vector3.new(0, 6, 0))
	end
	return tpToInstance(und, Vector3.new(0, 8, 0))
end

-- 던전 밖이면 게이트 TP → 입장 프롬프트
function AutoFarm.ensureDungeonEntry()
	if isInDungeon() then
		return true
	end

	local now = os.clock()
	if now - (AutoFarm.lastDungeonEnter or 0) < 2.5 then
		tryClickDungeonEnterUi()
		return false
	end
	AutoFarm.lastDungeonEnter = now

	if workspace:FindFirstChild("Undercave") then
		if tpInsideUndercaveIfLoaded() then
			AutoFarm.statusText = "던전 내부 TP..."
		end
	end

	local gate = getUndercaveGate()
	if not gate then
		AutoFarm.statusText = "던전 게이트 없음"
		return false
	end

	local part = gate:IsA("BasePart") and gate or gate:FindFirstChildWhichIsA("BasePart", true)
	if part then
		tpToInstance(part, Vector3.new(0, 3, 8))
	end

	local prompt = getDungeonEntryPrompt(gate)
	if prompt then
		task.defer(function()
			if AutoFarm.autoDungeon and not isInDungeon() then
				triggerWorldPrompt(prompt)
				tryClickDungeonEnterUi()
			end
		end)
		AutoFarm.statusText = "던전 입장 중"
	else
		AutoFarm.statusText = "던전 입장 프롬프트 없음"
	end

	tryClickDungeonEnterUi()
	return false
end

local function getDungeonRoomZone(roomIndex)
	local und = workspace:FindFirstChild("Undercave")
	local rooms = und and und:FindFirstChild("Rooms")
	if not rooms or not roomIndex then
		return nil
	end
	local room = rooms:FindFirstChild("Room" .. tostring(roomIndex))
		or rooms:FindFirstChild(string.format("Room%02d", roomIndex))
	if not room then
		return nil
	end
	local zone = room:FindFirstChild("RoomZone")
	if zone and zone:IsA("BasePart") then
		return zone
	end
	return room
end

local function findOpenDungeonDoorPart()
	local und = workspace:FindFirstChild("Undercave")
	local doors = und and und:FindFirstChild("Doors")
	if not doors then
		return nil
	end
	local hrp = getChar()
	local origin = hrp and hrp.Position or Vector3.zero
	local best, bestD = nil, math.huge
	for _, d in doors:GetDescendants() do
		if d:IsA("BasePart") and (d.CanCollide == false or d.Transparency >= 0.8 or d:GetAttribute("DoorsOpen") == true) then
			local dist = (d.Position - origin).Magnitude
			if dist < bestD then
				best, bestD = d, dist
			end
		end
	end
	return best
end

local function findDungeonMob(exclude)
	local hrp = getChar()
	local origin = hrp and hrp.Position or Vector3.zero
	local best, bestD = nil, math.huge
	for _, m in iterMonsters() do
		if m ~= exclude and aliveMob(m) then
			local root = getMobRoot(m)
			if root then
				local d = (root.Position - origin).Magnitude
				if d < bestD then
					best, bestD = m, d
				end
			end
		end
	end
	return best
end

function AutoFarm.tryDungeonClear()
	if not AutoFarm.autoDungeon then
		return false
	end

	local hrp, hum = getChar()
	if not hrp then
		return false
	end

	if not isInDungeon() then
		AutoFarm.ensureDungeonEntry()
		return true
	end

	AutoFarm.tryHeal(hum)
	AutoFarm.trySkills()

	local target = AutoFarm.dungeonTarget
	if not aliveMob(target) then
		target = findDungeonMob(target)
		AutoFarm.dungeonTarget = target
	end

	if target then
		AutoFarm.floatAbove(hrp, hum, target)
		AutoFarm.tryAttack(target)
		AutoFarm.statusText = "던전 전투" .. tostring(target:GetAttribute(MONSTER_ATTR) or target.Name)
		return true
	end

	local now = os.clock()
	if now - (AutoFarm.lastDungeonAdvance or 0) < 1.1 then
		AutoFarm.statusText = "던전 다음 방 대기"
		return true
	end
	AutoFarm.lastDungeonAdvance = now

	local st = AutoFarm.dungeonState
	local roomIndex = st and tonumber(st.roomIndex)
	local dest = nil
	if st and st.state == "roaming" and roomIndex then
		dest = getDungeonRoomZone(roomIndex)
	end
	if not dest and roomIndex then
		dest = getDungeonRoomZone(roomIndex + 1) or getDungeonRoomZone(roomIndex)
	end
	if not dest then
		dest = findOpenDungeonDoorPart()
	end
	if dest then
		tpToInstance(dest, Vector3.new(0, 5, 0))
		AutoFarm.statusText = "던전 다음 방 이동"
	else
		tpInsideUndercaveIfLoaded()
		AutoFarm.statusText = "던전 방 탐색"
	end
	return true
end

