local function resolveMobId(token)
	token = tostring(token or "")
	if token == "" then
		return nil
	end
	if token == MOB_ALL or token == "All" or token == "전체" then
		return MOB_ALL
	end
	-- 한글 이름
	if MOB_KO_TO_ID[token] then
		return MOB_KO_TO_ID[token]
	end
	-- "이름 (bear)" 형태
	local parenId = string.match(token, "%(([%w_]+)%)%s*$")
	if parenId then
		local def = MonsterDefs[parenId]
		if type(def) == "table" and type(def.monsterId) == "string" then
			return def.monsterId
		end
		return parenId
	end
	local def = MonsterDefs[token]
	if type(def) == "table" and type(def.monsterId) == "string" then
		return def.monsterId
	end
	for id, d in pairs(MonsterDefs) do
		if type(d) == "table" then
			local mid = d.monsterId or id
			if mid == token or mobDisplayName(mid) == token then
				return mid
			end
		end
	end
	return token
end

local function getMobRoot(m)
	return m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
end

local function aliveMob(m)
	if not m or not m:IsA("Model") or not m.Parent then
		return false
	end
	if not m:IsDescendantOf(workspace) then
		return false
	end
	if m:GetAttribute("Dead") == true then
		return false
	end
	local hum = m:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return false
	end
	return getMobRoot(m) ~= nil
end

local function mobAllowed(id)
	id = resolveMobId(id)
	if not id or id == MOB_ALL then
		return AutoFarm.selectedMobs[MOB_ALL] == true or AutoFarm.selectedMobs.All == true
	end
	-- 자동 퀘스트 목표 몹은 선택과 무관하게 허용
	if AutoFarm.autoQuest and AutoFarm.questMobTarget and id == AutoFarm.questMobTarget then
		return true
	end
	if AutoFarm.selectedMobs[MOB_ALL] or AutoFarm.selectedMobs.All then
		return true
	end
	return AutoFarm.selectedMobs[id] == true
end

local function isValidHuntTarget(m)
	if not aliveMob(m) then
		return false
	end
	local id = m:GetAttribute(MONSTER_ATTR)
	return type(id) == "string" and mobAllowed(id)
end

local function getDecorTreesFolder()
	local decorations = workspace:FindFirstChild("Decorations")
	return decorations and decorations:FindFirstChild("Trees")
end

-- Decorations/Trees 아래 (하위 폴더 포함)
local function underDecorTrees(inst)
	local folder = getDecorTreesFolder()
	return folder ~= nil and inst:IsDescendantOf(folder)
end

local function underMineralFolder(inst)
	local p = inst
	while p and p ~= workspace do
		local n = string.lower(p.Name)
		if n:find("mineral", 1, true) or n:find("ore", 1, true) or n:find("crystal", 1, true) then
			return true
		end
		p = p.Parent
	end
	return false
end

-- 폴더만 감싼 상위 Model은 건너뛰고, 실제 파츠가 있는 말단 Model만
local function isLeafTreeModel(m)
	if not m:FindFirstChildWhichIsA("BasePart", true) then
		return false
	end
	for _, c in m:GetChildren() do
		if c:IsA("Model") and c:FindFirstChildWhichIsA("BasePart", true) then
			return false
		end
	end
	return true
end

local function isChopTree(m)
	if not m or not m:IsA("Model") or not m.Parent then
		return false
	end
	if knownMinerals[m] or underMineralFolder(m) then
		return false
	end
	if fallingTrees[m] then
		return false
	end
	if m:GetAttribute("Dead") == true then
		return false
	end
	if m:GetAttribute(MONSTER_ATTR) ~= nil then
		return false
	end
	if m:FindFirstChildOfClass("Humanoid") then
		return false
	end
	if not getMobRoot(m) then
		return false
	end

	-- 메인: Decorations/Trees 안 모델
	if underDecorTrees(m) and isLeafTreeModel(m) then
		return true
	end

	-- 보조: 서버 FX로 확인된 나무
	return knownTrees[m] == true
end

local function learnTree(model)
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return
	end
	if underMineralFolder(model) or knownMinerals[model] then
		return
	end
	-- Decorations/Trees 또는 서버가 나무로 보낸 것만
	if underDecorTrees(model) or knownTrees[model] then
		knownTrees[model] = true
	elseif not underDecorTrees(model) then
		-- Trees 밖 FX는 나무 hit/fall일 때만 호출됨
		knownTrees[model] = true
	end
	knownMinerals[model] = nil
end

local function learnMineral(model)
	if typeof(model) == "Instance" and model:IsA("Model") then
		knownMinerals[model] = true
		knownTrees[model] = nil
		if AutoFarm.logTarget == model then
			AutoFarm.logTarget = nil
		end
	end
end

