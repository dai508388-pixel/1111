local function _resolveEnv()
	local ok, g = pcall(function()
		return getgenv()
	end)
	if ok and type(g) == "table" then
		return g
	end
	if type(_G) == "table" then
		return _G
	end
	return {}
end

local EXEC = _resolveEnv()
local function execFn(name)
	local v = EXEC[name]
	if type(v) == "function" then
		return v
	end
	local ok, g = pcall(function()
		return rawget(_G, name)
	end)
	if ok and type(g) == "function" then
		return g
	end
	return nil
end

