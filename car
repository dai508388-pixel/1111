function Farm2.findMobNearSpot(exclude)
	local spot = Farm2.getSpot(Farm2.mobId)
	if typeof(spot) ~= "Vector3" then
		return nil
	end
	local best, bestD = nil, math.huge
	local r = tonumber(Farm2.radius) or 140
	for _, m in iterMonsters() do
		if m ~= exclude and aliveMob(m) then
			local id = m:GetAttribute(MONSTER_ATTR)
			if id == Farm2.mobId then
				local root = getMobRoot(m)
				if root then
					local d = (root.Position - spot).Magnitude
					if d <= r and d < bestD then
						best, bestD = m, d
					end
				end
			end
		end
	end
	-- 반경 안 없으면 같은 종류 전역 최근접 (멀리 있는 개체)
	if not best then
		for _, m in iterMonsters() do
			if m ~= exclude and aliveMob(m) and m:GetAttribute(MONSTER_ATTR) == Farm2.mobId then
				local root = getMobRoot(m)
				if root then
					local d = (root.Position - spot).Magnitude
					if d < bestD then
						best, bestD = m, d
					end
				end
			end
		end
	end
	return best
end

function Farm2.tick()
	if not Farm2.enabled then
		return false
	end
	local hrp, hum = getChar()
	if not hrp then
		Farm2.status = "캐릭터 없음"
		return true
	end

	if Farm2.useHeal then
		AutoFarm.tryHeal(hum, true)
	end
	if Farm2.useSkills then
		AutoFarm.trySkills()
	end

	local spot = Farm2.getSpot(Farm2.mobId)
	if typeof(spot) ~= "Vector3" then
		Farm2.status = "스팟 미설정 — 위치 저장 필요"
		return true
	end

	-- 자리 이탈 복귀
	local target = Farm2.target
	if not (target and aliveMob(target) and target:GetAttribute(MONSTER_ATTR) == Farm2.mobId) then
		target = Farm2.findMobNearSpot(nil)
		Farm2.target = target
	end

	if (not target) and Farm2.autoReturn then
		local dist = (hrp.Position - spot).Magnitude
		if dist > (tonumber(Farm2.returnDist) or 90) then
			Farm2.tpToSpot(Farm2.mobId, false)
			return true
		end
	end

	if target then
		local root = getMobRoot(target)
		if root then
			if (root.Position - hrp.Position).Magnitude > 70 then
				tpToSafePos(hrp, hum, root.Position, Farm2.hoverHeight)
			end
			local stand, look = safeStandPos(root.Position, Farm2.hoverHeight)
			if stand then
				hrp.CFrame = CFrame.lookAt(stand, look or root.Position)
			end
			hrp.AssemblyLinearVelocity = Vector3.zero
			pcall(function()
				if hum then
					hum.PlatformStand = true
				end
			end)
			local now = os.clock()
			if now - AutoFarm.lastAttack >= swingCd() then
				AutoFarm.lastAttack = now
				AutoFarm.swordAttack()
			end
			Farm2.status = "F2: " .. mobDisplayName(Farm2.mobId) .. " 사냥 중"
			AutoFarm.statusText = Farm2.status
			return true
		end
	end

	-- 몹 없음 → 스팟에서 대기 (스트리밍/리스폰)
	if Farm2.stayOnEmpty then
		local hover = select(1, safeStandPos(spot, Farm2.hoverHeight)) or (spot + Vector3.new(0, Farm2.hoverHeight, 0))
		if (hrp.Position - hover).Magnitude > 12 then
			Farm2.tpToSpot(Farm2.mobId, false)
		else
			hrp.CFrame = CFrame.new(hover)
			hrp.AssemblyLinearVelocity = Vector3.zero
			pcall(function()
				if hum then
					hum.PlatformStand = true
				end
			end)
		end
		Farm2.status = "F2: 리스폰 대기 @ " .. mobDisplayName(Farm2.mobId)
		AutoFarm.statusText = Farm2.status
	else
		Farm2.status = "F2: 몹 없음"
	end
	return true
end

