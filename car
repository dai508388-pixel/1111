local function angDiffDeg(a, b)
	local d = math.abs((a - b) % 360)
	if d > 180 then
		d = 360 - d
	end
	return d
end

local function pointerAngleDeg(pointer)
	local ox = pointer.Position.X.Offset
	local oy = pointer.Position.Y.Offset
	if math.abs(ox) < 0.5 and math.abs(oy) < 0.5 then
		return nil
	end
	return (math.deg(math.atan2(oy, ox)) + 90) % 360
end

-- 켜진 세그먼트로 아크 중심/반각 추정 (연속 각도 판정용)
local function getFishingArc(panel)
	local segments = panel:FindFirstChild("Segments")
	if not segments then
		return nil
	end
	local segCount = math.max(8, math.floor(tonumber(panel:GetAttribute("SegmentCount")) or 48))
	local step = 360 / segCount
	local lit = {}
	for i = 0, segCount - 1 do
		local seg = segments:FindFirstChild("Seg" .. i)
		if seg and seg:IsA("GuiObject") and seg.BackgroundTransparency <= 0.35 then
			lit[#lit + 1] = i
		end
	end
	if #lit == 0 then
		return nil
	end

	local sx, sy = 0, 0
	for _, i in ipairs(lit) do
		local rad = math.rad(i * step)
		sx = sx + math.cos(rad)
		sy = sy + math.sin(rad)
	end
	local center = math.deg(math.atan2(sy, sx)) % 360
	local half = 0
	for _, i in ipairs(lit) do
		half = math.max(half, angDiffDeg(i * step, center))
	end
	-- 세그먼트 양자화로 가장자리 오판 줄이기
	half = math.max(5, half - step * 0.4)
	local key = string.format("%.1f:%.1f:%d", center, half, #lit)
	return center, half, key
end

-- 펄스 정중앙에서만 E
local function fishTapE()
	local now = os.clock()
	if now - AutoFarm.lastFishTap < 0.2 then
		return
	end
	AutoFarm.lastFishTap = now
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
	end)
end

local function signedAngDelta(fromDeg, toDeg)
	return (toDeg - fromDeg + 180) % 360 - 180
end

local function resetFishRoundState()
	AutoFarm.fishPrevAng = nil
	AutoFarm.fishPrevT = nil
	AutoFarm.fishArcKey = nil
	AutoFarm.fishTappedArc = false
end

function AutoFarm.tryFishMinigame()
	local panel = getFishingPanel()
	if not panel or not panel.Visible then
		if AutoFarm.fishSession then
			AutoFarm.fishSession = false
		end
		resetFishRoundState()
		return false
	end

	AutoFarm.fishSession = true
	local _, hum = getChar()
	if hum then
		AutoFarm.resetMovement(hum)
	end

	local pointer = panel:FindFirstChild("Pointer")
	if not pointer or not pointer.Visible then
		resetFishRoundState()
		AutoFarm.statusText = "낚시 — 입질 대기"
		return true
	end

	local center, half, key = getFishingArc(panel)
	if not center then
		resetFishRoundState()
		AutoFarm.statusText = "낚시 — 라운드 대기"
		return true
	end

	if key ~= AutoFarm.fishArcKey then
		AutoFarm.fishArcKey = key
		AutoFarm.fishTappedArc = false
		AutoFarm.fishPrevAng = nil
		AutoFarm.fishPrevT = nil
	end

	local ang = pointerAngleDeg(pointer)
	if not ang then
		AutoFarm.statusText = "낚시 미니게임"
		return true
	end

	local now = os.clock()
	local vel = 0
	local prevAng = AutoFarm.fishPrevAng
	if prevAng and AutoFarm.fishPrevT then
		local dt = now - AutoFarm.fishPrevT
		if dt > 0.001 and dt < 0.12 then
			vel = signedAngDelta(prevAng, ang) / dt
		end
	end
	AutoFarm.fishPrevAng = ang
	AutoFarm.fishPrevT = now

	if AutoFarm.fishTappedArc then
		AutoFarm.statusText = "낚시 — 다음 라운드"
		return true
	end

	-- 성공 존(아크 half) 안에 들어오면 즉시 E — 정확도 100% 목표
	local leadT = 0.02
	local pred = (ang + vel * leadT) % 360
	local distNow = angDiffDeg(ang, center)
	local distPred = angDiffDeg(pred, center)

	local crossedCenter = false
	if prevAng and math.abs(vel) > 8 then
		local before = signedAngDelta(center, prevAng)
		local after = signedAngDelta(center, pred)
		if before * after <= 0 and math.abs(before) <= half and math.abs(after) <= half then
			crossedCenter = true
		end
	end

	local inZone = distNow <= (half * 0.98) or distPred <= (half * 0.95)
	local nearCenter = distNow <= math.max(1.2, half * 0.4) or distPred <= math.max(1.5, half * 0.45)

	if crossedCenter or inZone or nearCenter then
		fishTapE()
		task.defer(fishTapE)
		AutoFarm.fishTappedArc = true
		AutoFarm.statusText = "낚시 — 히트"
	else
		AutoFarm.statusText = "낚시 — 존 대기"
	end
	return true
end

function AutoFarm.tryStartFish()
	if not AutoFarm.autoFish or AutoFarm.fishSession then
		return false
	end

	local hrp, hum = getChar()
	if not hrp then
		return false
	end

	-- 절대 텔레포트하지 않음 — 물가에 직접 선 상태에서만 프롬프트
	if hum then
		AutoFarm.resetMovement(hum)
	end

	local prompt, spot = findMyFishingPrompt()
	if not prompt then
		AutoFarm.statusText = "낚시 — 물가에 서세요 (자리 대기)"
		return true
	end

	if not prompt.Enabled then
		AutoFarm.statusText = "낚시 — 세션 대기"
		return true
	end

	local maxDist = tonumber(prompt.MaxActivationDistance) or 10
	local dist = fishingPromptDistance(prompt, spot, hrp)
	if dist > maxDist + 1.5 then
		AutoFarm.statusText = string.format("낚시 — 물가로 더 가까이 (%.0f칸)", dist)
		return true
	end

	local cd = tonumber(FishingDefs.COOLDOWN) or 2
	local now = os.clock()
	if now - AutoFarm.lastFishPrompt < cd then
		AutoFarm.statusText = "낚시 — 쿨다운"
		return true
	end

	if AutoFarm.fishPromptBusy then
		return true
	end

	AutoFarm.fishPromptBusy = true
	AutoFarm.lastFishPrompt = now
	AutoFarm.statusText = "낚시 시작"
	task.spawn(function()
		triggerFishingPrompt(prompt)
		task.wait(0.4)
		AutoFarm.fishPromptBusy = false
	end)
	return true
end

function AutoFarm.tryFish()
	if not AutoFarm.autoFish then
		return false
	end
	if AutoFarm.tryFishMinigame() then
		return true
	end
	return AutoFarm.tryStartFish()
end

