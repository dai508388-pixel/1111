-- 진행도 기준으로 plan 갱신 (사냥 ON이어도 반납 전환)
local function refreshQuestPlanFromProgress()
	if not AutoFarm.autoQuest then
		return nil
	end
	local plan = AutoFarm.questPlan
	if (not plan or not plan.questId) and type(LocalPlayer:GetAttribute("TrackedQuest")) == "string" then
		local tracked = LocalPlayer:GetAttribute("TrackedQuest")
		if QuestDefs[tracked] then
			markQuestAccepted(tracked)
			plan = analyzeQuest(tracked, nil, nil)
		end
	end
	if not plan or not plan.questId then
		return plan
	end
	local def = QuestDefs[plan.questId]
	if not def then
		return plan
	end
	local p = questPhase(def)
	local mob = questTargetMonster(def)
	plan.mobId = mob or plan.mobId
	plan.phase = p
	plan.need = def.condition and tonumber(def.condition.required) or plan.need or 0
	local prog = AutoFarm.questProgress[plan.questId]
	plan.cur = prog and tonumber(prog.progress) or 0

	if p == "ready_to_turn_in" then
		if plan.mode ~= "talk_turnin" then
			AutoFarm.currentTarget = nil
			AutoFarm.questTalkCooldownUntil = 0
			AutoFarm.statusText = "퀘스트 완료 → 턴인"
		end
		plan.mode = "talk_turnin"
	elseif p == "completed" then
		plan.mode = "idle"
		AutoFarm.questMobTarget = nil
		AutoFarm.questAppliedMob = nil
	elseif p == "in_progress" and plan.mobId then
		plan.mode = "hunt"
	elseif p == "offer" then
		plan.mode = "talk_accept"
	end
	AutoFarm.questPlan = plan
	return plan
end

local function ensureQuestMobInRange(hrp, mobId, target)
	if not AutoFarm.autoQuest then
		return target
	end
	if not hrp or type(mobId) ~= "string" then
		return target
	end
	if target and isValidHuntTarget(target) then
		local root = getMobRoot(target)
		if root then
			if (root.Position - hrp.Position).Magnitude > HUNT_MOB_FAR then
				tpToSafePos(hrp, select(2, getChar()), root.Position, AutoFarm.hoverHeight)
			end
			return target
		end
	end
	local live = findAnyAliveMobPos(mobId)
	if live then
		tpToSafePos(hrp, select(2, getChar()), live, AutoFarm.hoverHeight)
		return nil
	end
	tpToMobSpawn(mobId, "퀘스트 스폰 TP")
	return nil
end
