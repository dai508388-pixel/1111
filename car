						AutoFarm.statusText = "수정 획득 — 다음 탐색"
					end
				elseif kind == "mineral_respawn" then
					shatteredMinerals[model] = nil
				end
				return
			end

			-- 나무만: hit / fall / respawn
			if kind == "hit" or kind == "fall" or kind == "respawn" then
				learnTree(model)
			end

			if kind == "fall" then
				fallingTrees[model] = true
				if AutoFarm.logTarget == model then
					AutoFarm.logTarget = nil
					AutoFarm.statusText = "나무 넘어짐 — 다음 탐색"
				end
				task.delay(4, function()
					fallingTrees[model] = nil
				end)
			elseif kind == "respawn" then
				fallingTrees[model] = nil
			end
		end)
	end)

	pcall(function()
		-- e0da01b(slot, ?, cooldown) — 슬롯별 쿨 동기화
		getRemote("e0da01b", "RemoteEvent").OnClientEvent:Connect(function(p1, _p2, p3)
			local slot = tonumber(p1)
			local cd = tonumber(p3)
			if slot and slot >= 1 and slot <= 4 and cd then
				if cd <= 0 then
					AutoFarm.skillFinishAt[slot] = 0
				else
					AutoFarm.skillFinishAt[slot] = os.clock() + cd
				end
			end
		end)
	end)

	pcall(function()
		-- 낚시 세션 시작 / 종료
		getRemote("e51db9a", "RemoteEvent").OnClientEvent:Connect(function(p1)
			if type(p1) == "table" and p1.ok == true then
				AutoFarm.fishSession = true
				AutoFarm.statusText = "낚시 — 입질 대기"
			end
		end)
		getRemote("e9a3c07", "RemoteEvent").OnClientEvent:Connect(function()
			AutoFarm.fishSession = false
			if AutoFarm.autoFish then
				AutoFarm.statusText = "낚시 — 재시작 대기"
			end
		end)
	end)

	-- 인벤토리 동기화 (자동 판매 / 상점 UI)
	pcall(function()
		getRemote("e9131bc", "RemoteEvent").OnClientEvent:Connect(function(p1)
			if type(p1) ~= "table" then
				return
			end
			if type(p1.inventory) == "table" then
				AutoFarm.inventory = p1.inventory
			end
			if type(p1.equipment) == "table" then
				AutoFarm.equipment = p1.equipment
			end
			if tonumber(p1.gold) then
				AutoFarm.gold = tonumber(p1.gold)
			end
		end)
	end)

	-- 포션 쿨다운 동기화
	pcall(function()
		getRemote("e459d82", "RemoteEvent").OnClientEvent:Connect(function(p1)
			if type(p1) ~= "table" then
				return
			end
			local cd = tonumber(p1.cooldown) or 0
			local started = tonumber(p1.startedAt)
			local remain = cd
			if started and started > 0 then
				remain = math.max(0, (started + cd) - workspace:GetServerTimeNow())
			end
			AutoFarm.potionCdUntil = os.clock() + remain
		end)
	end)

	pcall(function()
		getRemote("e48d3fd", "RemoteEvent").OnClientEvent:Connect(function(p1)
			if type(p1) ~= "table" then
				return
			end
			if tonumber(p1.gold) then
				AutoFarm.gold = tonumber(p1.gold)
			end
			if type(p1.enhance) == "table" then
				AutoFarm.enhance = p1.enhance
			end
			if type(p1.questProgress) ~= "table" then
				return
			end
			-- 서버 스냅샷을 우선 (로컬 stale 진행도가 완료를 막는 문제 수정)
			local merged = {}
			for qid, prog in pairs(p1.questProgress) do
				if type(qid) == "string" and type(prog) == "table" then
					merged[qid] = {
						accepted = prog.accepted == true,
						completed = prog.completed == true,
						progress = tonumber(prog.progress) or 0,
					}
				end
			end
			-- 서버에 아직 없는 "방금 수락"만 짧게 유지
			local now = os.clock()
			for qid, prog in pairs(AutoFarm.questProgress) do
				if merged[qid] == nil and type(prog) == "table" and prog.accepted == true and prog.completed ~= true then
					local age = now - (tonumber(prog._localAt) or 0)
					if age >= 0 and age < 8 then
						merged[qid] = prog
					end
				end
			end
			AutoFarm.questProgress = merged
			if AutoFarm.autoQuest then
				refreshQuestPlanFromProgress()
			end
		end)

		-- 말 걸기 → 수락/반납 → 닫기 → 분석 (사냥은 유저 팜)
		getRemote("ebd" .. "9a45", "RemoteEvent").OnClientEvent:Connect(function(p1)
			if not AutoFarm.autoQuest or type(p1) ~= "table" then
				return
			end

			local phase = p1.phase
			local qid = p1.questId
			local npcId = p1.npcId

			-- 1) 버튼 동작
			if phase == "offer" and npcId then
				fireQuestAction(npcId, "accept", qid)
				markQuestAccepted(qid)
			elseif phase == "job_offer" and npcId then
				fireQuestAction(npcId, "job_accept", qid)
				markQuestAccepted(qid)
			elseif phase == "ready_to_turn_in" and npcId then
				fireQuestAction(npcId, "turnin", qid)
				markQuestTurnedIn(qid)
			elseif phase == "in_progress" then
				markQuestAccepted(qid)
			end

			if type(qid) == "string" and qid ~= "" then
				pcall(function()
					LocalPlayer:SetAttribute("TrackedQuest", qid)
				end)
			end

			-- 2) 닫기 + 카메라 해제 (확인 후 화면 고정 방지)
			AutoFarm.questTalkCooldownUntil = os.clock() + 1.2
			task.delay(0.25, function()
				closeQuestDialog()
				releaseQuestCamera()
			end)
			task.delay(0.7, releaseQuestCamera)

			-- 3) 분석 → 스팟 TP 준비 / 반납 후 다음 퀘스트 (사냥은 유저 팜)
			task.delay(0.85, function()
				if not AutoFarm.autoQuest then
					return
				end
				releaseQuestCamera()

				if phase == "ready_to_turn_in" then
					-- 반납 끝 → plan 비우고 다음 퀘스트 받으러
					AutoFarm.questPlan = nil
					AutoFarm.questMobTarget = nil
					AutoFarm.questAppliedMob = nil
					AutoFarm.questTalkCooldownUntil = os.clock() + 0.8
					AutoFarm.statusText = "다음 퀘스트"
					return
				end

				local plan = analyzeQuest(qid, phase, npcId)
				if plan.mobId and (phase == "offer" or phase == "in_progress" or phase == "job_offer" or plan.mode == "hunt") then
					markQuestAccepted(qid)
					plan.mode = "hunt"
					plan.phase = "in_progress"
					AutoFarm.questPlan = plan
					applyQuestHuntMob(plan.mobId)
					Farm2.mobId = plan.mobId
					AutoFarm.statusText = "퀘스트 스팟 " .. plan.mobId
				elseif phase == "none" or not qid then
					AutoFarm.questPlan = nil
					AutoFarm.questTalkCooldownUntil = os.clock() + 8
					AutoFarm.statusText = "퀘스트 없음"
				end
			end)
		end)
	end)

	print("[Star Hub] 벌목/스킬/낚시/퀘스트 동기화 시작")
end)

