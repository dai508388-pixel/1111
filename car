	local function getPlayerGold()
		if tonumber(AutoFarm.gold) and AutoFarm.gold > 0 then
			return AutoFarm.gold
		end
		for _, key in ipairs({ "Gold", "gold", "Money", "money" }) do
			local v = tonumber(LocalPlayer:GetAttribute(key))
			if v then
				return v
			end
		end
		local gold = 0
		pcall(function()
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			local label = pg and pg:FindFirstChild("GoldLabel", true)
			if label and label:IsA("TextLabel") then
				local n = string.gsub(tostring(label.Text or ""), "[^%d]", "")
				gold = tonumber(n) or 0
			end
		end)
		return gold
	end

	-- 서버→클라 OnClientEvent를 로컬에서 Fire (e14b5f0 / edb68d3)
	local function fireClientRemote(logicalId, payload)
		local rem = getRemote(logicalId, "RemoteEvent")
		local fired = false
		local signal = rem.OnClientEvent

		pcall(function()
			if type(_firesignal) == "function" then
				_firesignal(signal, payload)
				fired = true
			end
		end)

		pcall(function()
			if type(_getconnections) ~= "function" then
				return
			end
			local list = _getconnections(signal)
			if type(list) ~= "table" then
				return
			end
			for _, c in ipairs(list) do
				if type(c) == "table" then
					if c.Fire then
						c:Fire(payload)
						fired = true
					elseif c.fire then
						c:fire(payload)
						fired = true
					elseif type(c.Function) == "function" then
						task.spawn(c.Function, payload)
						fired = true
					end
				elseif type(c) == "function" then
					task.spawn(c, payload)
					fired = true
				end
			end
		end)

		pcall(function()
			if signal and type(signal.Fire) == "function" then
				signal:Fire(payload)
				fired = true
			end
		end)

		return fired
	end

