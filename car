-- 대화/Defs 분석 → plan (hunt / talk_accept / talk_turnin)
local function analyzeQuest(questId, dialogPhase, npcId)
	local def = type(questId) == "string" and QuestDefs[questId] or nil
	local mob = def and questTargetMonster(def) or nil
	local phase = dialogPhase
	if def and (phase == nil or phase == "") then
		phase = questPhase(def)
	end

	local mode = "idle"
	if phase == "offer" or phase == "job_offer" then
		mode = "talk_accept"
	elseif phase == "ready_to_turn_in" then
		mode = "talk_turnin"
	elseif phase == "in_progress" then
		mode = mob and "hunt" or "idle"
	elseif def then
		local p = questPhase(def)
		phase = p
		if p == "in_progress" and mob then
			mode = "hunt"
		elseif p == "ready_to_turn_in" then
			mode = "talk_turnin"
		elseif p == "offer" then
			mode = "talk_accept"
		end
	end

	-- 이미 수락된 수집/처치면 바로 사냥
	if (mode == "talk_accept" or phase == "offer") and mob then
		local prog = AutoFarm.questProgress[questId]
		if prog and prog.accepted == true and prog.completed ~= true then
			mode = "hunt"
			phase = "in_progress"
		end
	end

	local prog = questId and AutoFarm.questProgress[questId]
	AutoFarm.questPlan = {
		questId = questId,
		npcId = npcId,
		npcKey = (questId and questToNpcKey[questId]) or "village_elder",
		phase = phase,
		mode = mode,
		mobId = mob,
		need = def and def.condition and tonumber(def.condition.required) or 0,
		cur = prog and tonumber(prog.progress) or 0,
		analyzedAt = os.clock(),
	}
	print("[Star Hub] 퀘스트 분석", questId, mode, mob)
	return AutoFarm.questPlan
end

