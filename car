-- SafeZone(로비) 판정 — ZoneUtil과 동일 로직
local function pointInZonePart(part, pos)
	if not part or not part:IsA("BasePart") or typeof(pos) ~= "Vector3" then
		return false
	end
	local zoneRadius = part:GetAttribute("ZoneRadius")
	if part:GetAttribute("ZoneShape") == "cylinder" or type(zoneRadius) == "number" then
		local r = tonumber(zoneRadius)
		if not r then
			r = math.min(part.Size.Y, part.Size.Z) / 2
		end
		local dx = pos.X - part.Position.X
		local dz = pos.Z - part.Position.Z
		return (dx * dx + dz * dz) <= (r * r)
	end
	local lp = part.CFrame:PointToObjectSpace(pos)
	local half = part.Size / 2
	return math.abs(lp.X) <= half.X and math.abs(lp.Y) <= half.Y and math.abs(lp.Z) <= half.Z
end

local function isInSafeZone(pos)
	if typeof(pos) ~= "Vector3" then
		return false
	end
	local okZ, tagged = pcall(function()
		return CollectionService:GetTagged("SafeZone")
	end)
	if not okZ or type(tagged) ~= "table" then
		return false
	end
	for _, part in ipairs(tagged) do
		if pointInZonePart(part, pos) then
			return true
		end
	end
	return false
end

-- PvP 전투: PvpOptIn ON + 로비(SafeZone) 제외
local function findPlayerTarget(exclude, pvpOnly)
	local hrp = getChar()
	if not hrp then
		return nil
	end
	if isInSafeZone(hrp.Position) then
		return nil
	end
	local best, bestD = nil, math.huge
	for _, plr in Players:GetPlayers() do
		if plr ~= LocalPlayer and plr ~= exclude then
			local allow = true
			if pvpOnly then
				allow = plr:GetAttribute("PvpOptIn") == true
			end
			if allow then
				local c = plr.Character
				local th = c and c:FindFirstChild("HumanoidRootPart")
				local hum = c and c:FindFirstChildOfClass("Humanoid")
				if th and hum and hum.Health > 0 and not isInSafeZone(th.Position) then
					local d = (th.Position - hrp.Position).Magnitude
					if d < bestD then
						best, bestD = plr, d
					end
				end
			end
		end
	end
	return best
end

local function tpNearPlayer(plr)
	local hrp, hum = getChar()
	local c = plr and plr.Character
	local th = c and c:FindFirstChild("HumanoidRootPart")
	if not (hrp and th) then
