function AutoFarm.tryQuest()
	if not AutoFarm.autoQuest then
		AutoFarm.questMobTarget = nil
		AutoFarm.questAppliedMob = nil
		AutoFarm.questPlan = nil
		return false
	end

	if LocalPlayer:GetAttribute("NpcDialogueOpen") == true then
		AutoFarm.statusText = "퀘스트 대화 중"
		return true
	end

	local plan = refreshQuestPlanFromProgress()
	if not plan or not plan.questId or plan.mode == "idle" then
		local def, phase = pickQuestFocus()
		if def then
			plan = analyzeQuest(def.questId, phase, nil)
		else
			plan = nil
			AutoFarm.questPlan = nil
		end
	end

	-- 줄 퀘스트 없음 → NPC 스팸 방지
	if not plan or not plan.questId then
		if os.clock() < (AutoFarm.questTalkCooldownUntil or 0) then
			AutoFarm.statusText = "퀘스트 없음"
			return true
		end
		AutoFarm.questTalkCooldownUntil = os.clock() + 8
		releaseQuestCamera()
		return goTalkNpc("village_elder")
	end

	-- 수락/반납: NPC 말걸기 (팜보다 우선)
	if plan.mode == "talk_accept" or plan.mode == "talk_turnin" then
		if os.clock() < (AutoFarm.questTalkCooldownUntil or 0) then
			AutoFarm.statusText = plan.mode == "talk_turnin" and "반납 대기" or "수락 대기"
			return true
		end
		releaseQuestCamera()
		AutoFarm.currentTarget = nil
		return goTalkNpc(plan.npcKey or "village_elder")
	end

	-- 진행 중: 몹 선택 + 스팟 TP, 사냥은 유저 팜에 양보
	if plan.mode == "hunt" and plan.mobId then
		local def = QuestDefs[plan.questId]
		if def and questPhase(def) == "ready_to_turn_in" then
			plan.mode = "talk_turnin"
			AutoFarm.questPlan = plan
			AutoFarm.questTalkCooldownUntil = 0
			AutoFarm.currentTarget = nil
			AutoFarm.statusText = "퀘스트 완료 → 반납"
			return goTalkNpc(plan.npcKey or "village_elder")
		end

		applyQuestHuntMob(plan.mobId)
		Farm2.mobId = plan.mobId
		local prog = AutoFarm.questProgress[plan.questId]
		local cur = prog and tonumber(prog.progress) or 0
		AutoFarm.statusText = string.format("퀘스트 %s (%d/%d)", plan.mobId, cur, plan.need or 0)

		local hrp = getChar()
		if hrp then
			local now = os.clock()
			local live = findAnyAliveMobPos(plan.mobId)
			local far = true
			if live then
				far = (live - hrp.Position).Magnitude > HUNT_MOB_FAR
			end
			if far and now - (AutoFarm.lastQuestSpawnTp or 0) > 4 then
				AutoFarm.lastQuestSpawnTp = now
				if live then
					tpToSafePos(hrp, select(2, getChar()), live, AutoFarm.hoverHeight)
				else
					tpToMobSpawn(plan.mobId, "퀘스트 스폰 TP")
				end
				return true
			end
		end

		-- 팜(사냥/오토팜2)이 잡게 양보
		return false
	end

	return false
end

