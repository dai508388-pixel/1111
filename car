	if m:FindFirstChildOfClass("Humanoid") then
		return false
	end
	if not getMobRoot(m) then
		return false
	end
	if knownMinerals[m] or underMineralSpots(m) or underMineralFolder(m) then
		return isLeafTreeModel(m) or knownMinerals[m] == true
	end
	return false
end

local function iterMonsters()
	local folder = workspace:FindFirstChild("Monsters")
	if not folder then
		return {}
	end
	local list = {}
	for _, child in folder:GetChildren() do
		if child:IsA("Model") then
			table.insert(list, child)
		end
	end
	return list
end

function AutoFarm.getMobList()
	local ids = { MOB_ALL }
	local seen = { [MOB_ALL] = true }

	local function add(id)
		if type(id) ~= "string" or id == "" or seen[id] then
			return
		end
		seen[id] = true
		table.insert(ids, id)
	end

	for _, def in pairs(MonsterDefs) do
		if type(def) == "table" and type(def.monsterId) == "string" then
			add(def.monsterId)
		end
	end

	-- 맵에 있는 몹도 항상 합침
	for _, m in iterMonsters() do
		add(m:GetAttribute(MONSTER_ATTR))
	end

	table.sort(ids, function(a, b)
		if a == MOB_ALL then
			return true
		end
		if b == MOB_ALL then
			return false
		end
		return a < b
	end)

	return ids
end

local MobListCache = { MOB_ALL }

function AutoFarm.applyMobSelection(sel)
	AutoFarm.selectedMobs = {}
	local arr = {}

	local function push(v)
		if v == nil then
			return
		end
		table.insert(arr, v)
	end

	if type(sel) == "string" or type(sel) == "number" then
		push(sel)
	elseif type(sel) == "table" then
		-- WindUI Multi 여러 포맷 대응
		if sel[1] ~= nil then
			for _, v in ipairs(sel) do
				push(v)
			end
		else
			for k, v in pairs(sel) do
				if v == true or v == 1 then
					push(k)
				elseif type(v) == "string" or type(v) == "number" then
					push(v)
				elseif type(v) == "table" then
					push(v)
				elseif type(k) == "string" and v ~= false and v ~= 0 then
					push(k)
				end
			end
		end
	end

	for _, v in ipairs(arr) do
		local raw
		if type(v) == "number" then
			raw = MobListCache[v] or MobListCache[v + 1]
		elseif type(v) == "table" then
			raw = v.Title or v.Value or v.Id or v.Name or v.title or v.value
		else
			raw = v
		end
		local id = resolveMobId(raw)
		if id then
			AutoFarm.selectedMobs[id] = true
		end
	end

	-- 전체 + 개별 동시 선택이면 전체만 유지
	if AutoFarm.selectedMobs[MOB_ALL] or AutoFarm.selectedMobs.All then
		AutoFarm.selectedMobs = { [MOB_ALL] = true }
	end

	if not next(AutoFarm.selectedMobs) then
		AutoFarm.selectedMobs[MOB_ALL] = true
	end

	-- 퀘스트가 강제로 잡아둔 몹과 다르면 퀘스트 고정 해제
	if AutoFarm.questAppliedMob and not AutoFarm.selectedMobs[AutoFarm.questAppliedMob] and not AutoFarm.selectedMobs[MOB_ALL] then
		AutoFarm.questAppliedMob = nil
	end

	AutoFarm.currentTarget = nil
	AutoFarm.selectionGen = (AutoFarm.selectionGen or 0) + 1
	AutoFarm.boundSelectionGen = -1
	AutoFarm.clearTarget("몹 선택 변경 — TP")
	local t = {}
	for k in pairs(AutoFarm.selectedMobs) do
		table.insert(t, tostring(k))
	end
	print("[Star Hub] 몹 선택:", table.concat(t, ", "))
	-- 사냥 중이면 선택한 몹으로 즉시 TP
	if AutoFarm.enabled then
		task.defer(function()
			if AutoFarm.enabled then
				AutoFarm.tpToSelectedMob("선택 몹 TP")
			end
		end)
	end
end

function AutoFarm.findTarget(exclude)
	local hrp = getChar()
	local origin = hrp and hrp.Position or Vector3.zero
	local best, bestD = nil, math.huge

	for _, m in iterMonsters() do
		if m ~= exclude and isValidHuntTarget(m) then
			local root = getMobRoot(m)
			if root then
				local d = (root.Position - origin).Magnitude
				if d < bestD then
					best, bestD = m, d
				end
			end
		end
	end

	return best
end

