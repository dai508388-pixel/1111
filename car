local _tpRayParams = RaycastParams.new()
_tpRayParams.FilterType = Enum.RaycastFilterType.Exclude
_tpRayParams.IgnoreWater = true

local function refreshTpRayFilter()
	local excl = {}
	local char = LocalPlayer.Character
	if char then
		table.insert(excl, char)
	end
	local monsters = workspace:FindFirstChild("Monsters")
	if monsters then
		table.insert(excl, monsters)
	end
	_tpRayParams.FilterDescendantsInstances = excl
end

local function safeStandPos(pos, hover)
	if typeof(pos) ~= "Vector3" then
		return nil, nil
	end
	hover = tonumber(hover) or AutoFarm.hoverHeight or 6
	refreshTpRayFilter()

	local inDungeon = LocalPlayer:GetAttribute("a26814") == true
	local undercave = workspace:FindFirstChild("Undercave")
	local useLocal = inDungeon
	if not useLocal and undercave then
		local ok, pivot = pcall(function()
			return undercave:GetPivot().Position
		end)
		if ok and pivot and (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(pivot.X, 0, pivot.Z)).Magnitude < 2500 and pos.Y < 120 then
			useLocal = true
		end
	end

	local hitY = nil
	if useLocal then
		local hit = workspace:Raycast(Vector3.new(pos.X, pos.Y + 70, pos.Z), Vector3.new(0, -160, 0), _tpRayParams)
		if hit then
			hitY = hit.Position.Y
		end
	else
		local surface = workspace:Raycast(Vector3.new(pos.X, 600, pos.Z), Vector3.new(0, -1200, 0), _tpRayParams)
		local near = workspace:Raycast(Vector3.new(pos.X, pos.Y + 90, pos.Z), Vector3.new(0, -180, 0), _tpRayParams)
		if surface then
			hitY = surface.Position.Y
		end
		if near then
			if pos.Y < near.Position.Y - 4 then
				hitY = near.Position.Y
			elseif not hitY then
				hitY = near.Position.Y
			elseif math.abs(near.Position.Y - pos.Y) + 2 < math.abs(hitY - pos.Y) then
				hitY = near.Position.Y
			end
		end
	end

	local baseY = pos.Y
	if hitY then
		if pos.Y < hitY - 3 then
			baseY = hitY
		else
			baseY = math.max(pos.Y, hitY)
		end
	end
	local stand = Vector3.new(pos.X, baseY + hover, pos.Z)
	local look = Vector3.new(pos.X, baseY + 1, pos.Z)
	return stand, look
end

local function tpToSafePos(hrp, hum, pos, hover)
	local stand = select(1, safeStandPos(pos, hover))
	if not (hrp and stand) then
		return false
	end
	if hum then
		AutoFarm.resetMovement(hum)
	end
	hrp.CFrame = CFrame.new(stand)
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	return true
end

function AutoFarm.floatAbove(hrp, hum, target)
	local root = getMobRoot(target)
	if not root then
		return false
	end
	local stand, look = safeStandPos(root.Position, AutoFarm.hoverHeight)
	if not stand then
		return false
	end
	hrp.CFrame = CFrame.lookAt(stand, look or root.Position)
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	pcall(function()
		hum.PlatformStand = true
	end)
	return true
end
-- 벌목: 나무 밑동(바닥) 옆에서 정면 공격 — 중심/꼭대기 금지
function AutoFarm.getTreeBase(tree)
	local ok, cf, size = pcall(function()
		return tree:GetBoundingBox()
	end)
	if ok and cf and size then
		local center = cf.Position
		-- 바운딩 박스 바닥 중앙 = 밑동
		local baseY = center.Y - size.Y * 0.5
		return Vector3.new(center.X, baseY, center.Z), size.Y
	end

	local lowest = nil
	local sum = Vector3.zero
	local count = 0
	for _, p in tree:GetDescendants() do
		if p:IsA("BasePart") then
			local pos = p.Position
			sum = sum + pos
			count = count + 1
			local bottom = pos.Y - p.Size.Y * 0.5
			if not lowest or bottom < lowest then
				lowest = bottom
			end
		end
	end
	if count == 0 then
		return nil, 0
	end
	local avg = sum / count
	return Vector3.new(avg.X, lowest or avg.Y, avg.Z), 0
end

function AutoFarm.standAtTree(hrp, hum, tree)
	local base = AutoFarm.getTreeBase(tree)
	if not base then
		return false
	end

	-- 수평으로만 방향 계산 (높이 무시)
	local flat = Vector3.new(hrp.Position.X - base.X, 0, hrp.Position.Z - base.Z)
	if flat.Magnitude < 0.5 then
		local look = hrp.CFrame.LookVector
		flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.1 then
			flat = Vector3.new(0, 0, -1)
		end
	end

	-- 밑동에서 3칸 떨어진 지상 높이(약 허리~가슴)
	local standY = base.Y + 3
	local stand = Vector3.new(base.X, standY, base.Z) + flat.Unit * 3
	local face = Vector3.new(base.X, standY, base.Z)

	hrp.CFrame = CFrame.lookAt(stand, face)
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	pcall(function()
		hum.PlatformStand = true
	end)
	return true
end

function AutoFarm.resetMovement(hum)
	pcall(function()
		hum.PlatformStand = false
	end)
end

-- 검 공격 — F키 연타 (UI/마우스 클릭 없음)
function AutoFarm.swordAttack()
	if LocalPlayer:GetAttribute("NpcDialogueOpen") == true then
		return false
	end
	local _, hum = getChar()
	if not hum then
		return false
	end
	-- 대화 후 CastSlowSpeed=0 이 남는 경우 해제
	if tonumber(LocalPlayer:GetAttribute("CastSlowSpeed")) == 0 then
		pcall(function()
			LocalPlayer:SetAttribute("CastSlowSpeed", nil)
		end)
		if tonumber(LocalPlayer:GetAttribute("CastSlowSpeed")) == 0 then
			return false
		end
	end

	local now = os.clock()
	if now - AutoFarm.lastFire < 0.12 then
		return false
	end

	local ok = pcall(function()
		local vim = game:GetService("VirtualInputManager")
		vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
		vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
	end)

	if ok then
		AutoFarm.lastFire = now
		-- 서버 판정 보조
		pcall(function()
			getRemote("e89c992", "RemoteEvent"):FireServer()
		end)
	end
	return ok
end

function AutoFarm.tryAttack(target)
	if not AutoFarm.autoAttack then
		return
	end
	local now = os.clock()
	if now - AutoFarm.lastAttack < swingCd() then
		return
	end
	AutoFarm.lastAttack = now
	AutoFarm.swordAttack()
	AutoFarm.statusText = "공격 중: " .. mobDisplayName(tostring(target:GetAttribute(MONSTER_ATTR)))
end

local function clearCastLock()
	if tonumber(LocalPlayer:GetAttribute("CastSlowSpeed")) == 0 then
		pcall(function()
			LocalPlayer:SetAttribute("CastSlowSpeed", nil)
		end)
	end
end

function AutoFarm.tryHeal(hum, force)
	if not force and not AutoFarm.autoHeal then
		return false
	end
	if not hum then
		return false
	end
	if LocalPlayer:GetAttribute("PotionSealed") == true then
		return false
	end
	if LocalPlayer:GetAttribute("NpcDialogueOpen") == true then
		return false
	end
	local maxHp = hum.MaxHealth
	if maxHp <= 0 or hum.Health <= 0 then
		return false
	end
	local pct = (hum.Health / maxHp) * 100
	local threshold = tonumber(AutoFarm.healPercent) or 50
	if pct > threshold then
		return false
	end
	local now = os.clock()
	-- 서버 쿨은 e459d82로 갱신, 로컬은 짧은 요청 쿨만
	if now < (AutoFarm.potionCdUntil or 0) then
		return false
	end
	local reqCd = tonumber(PotionConfig.CLIENT_REQUEST_COOLDOWN) or 0.15
	if now - AutoFarm.lastHeal < reqCd then
		return false
	end
	AutoFarm.lastHeal = now
	pcall(function()
		getRemote("e039a15", "RemoteEvent"):FireServer()
	end)
	-- R키 보조 (RenderStepped yield 방지 → spawn)
	task.spawn(function()
		pcall(function()
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
			task.wait(0.05)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
		end)
	end)
	AutoFarm.statusText = string.format("포션 %.0f%%", pct)
	return true
end

function AutoFarm.isSkillReady(slot)
	local now = os.clock()
	if now < (AutoFarm.skillFinishAt[slot] or 0) then
		return false
	end
	if now - (AutoFarm.lastSkill[slot] or 0) < 0.8 then
		return false
	end
	-- LockIcon만 본다 (Cover는 오탐 많아서 제외)
	local locked = false
	pcall(function()
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		local bar = pg and pg:FindFirstChild("SkillBar", true)
		local btn = bar and (bar:FindFirstChild("Slot" .. slot) or bar:FindFirstChild(tostring(slot)))
		if not btn then
			return
		end
		local lockIcon = btn:FindFirstChild("LockIcon", true)
		if lockIcon and lockIcon:IsA("GuiObject") and lockIcon.Visible then
			locked = true
		end
	end)
	return not locked
end

function AutoFarm.castSkillSlot(slot)
	clearCastLock()
	pcall(function()
		getRemote("e14ca84", "RemoteEvent"):FireServer(slot)
	end)
end

function AutoFarm.trySkills()
	local anySlot = false
	for i = 1, 4 do
		if AutoFarm.autoSkill[i] then
			anySlot = true
			break
		end
	end
	if not anySlot then
		return
	end
	if LocalPlayer:GetAttribute("NpcDialogueOpen") == true then
		return
	end
	clearCastLock()

	local now = os.clock()
	local start = AutoFarm.skillRR or 1

	-- 한 틱에 슬롯 1개만 (라운드 로빈)
	for offset = 0, 3 do
		local i = ((start + offset - 1) % 4) + 1
		if AutoFarm.autoSkill[i] and AutoFarm.isSkillReady(i) then
			AutoFarm.lastSkill[i] = now
			if (AutoFarm.skillFinishAt[i] or 0) < now then
				AutoFarm.skillFinishAt[i] = now + 0.8
			end
			AutoFarm.castSkillSlot(i)
			AutoFarm.skillRR = i + 1
			if AutoFarm.skillRR > 4 then
				AutoFarm.skillRR = 1
			end
			return
		end
	end
end

function AutoFarm.findTree(exclude)
	local hrp = getChar()
	local origin = hrp and hrp.Position or Vector3.zero
	local best, bestD = nil, math.huge
	local seen = {}

	local function consider(m)
		if not m or m == exclude or seen[m] then
			return
		end
		seen[m] = true
		if not isChopTree(m) then
			return
		end
		local root = getMobRoot(m)
		if not root then
			return
		end
		local d = (root.Position - origin).Magnitude
		if d < bestD then
			best, bestD = m, d
		end
	end

	-- Decorations/Trees (하위 폴더 모델 포함)
	local treesFolder = getDecorTreesFolder()
	if treesFolder then
		for _, d in treesFolder:GetDescendants() do
			if d:IsA("Model") then
				consider(d)
			end
		end
	end

	-- FX로 학습된 나무
	for m in pairs(knownTrees) do
		consider(m)
	end

	return best
end

function AutoFarm.tryChopTree()
	if not AutoFarm.autoLog then
		return false
	end

	local hrp, hum = getChar()
	if not hrp then
		return false
	end

	local tree = AutoFarm.logTarget
	if not tree or not isChopTree(tree) then
		tree = AutoFarm.findTree(tree)
		AutoFarm.logTarget = tree
	end

	if not tree then
		return false
	end

	-- 나무 옆에서 정면 공격 (머리 위 호버는 판정 안 맞음)
	AutoFarm.standAtTree(hrp, hum, tree)

	-- 벌목은 검 공격 토글과 무관하게 F / Remote
	local now = os.clock()
	if now - AutoFarm.lastAttack >= swingCd() then
		AutoFarm.lastAttack = now
		AutoFarm.swordAttack()
	end

	AutoFarm.statusText = "벌목 중: " .. tree.Name
	return true
end

function AutoFarm.findMineral(exclude)
	local hrp = getChar()
	local origin = hrp and hrp.Position or Vector3.zero
	local best, bestD = nil, math.huge
	local seen = {}

	local function consider(m)
		if not m or m == exclude or seen[m] then
			return
		end
		seen[m] = true
		if not isMineCrystal(m) then
			return
		end
		local root = getMobRoot(m)
		if not root then
			return
		end
		local d = (root.Position - origin).Magnitude
		if d < bestD then
			best, bestD = m, d
		end
	end

	local function scanFolder(folder)
		for _, child in folder:GetDescendants() do
			if child:IsA("Model") then
				consider(child)
			end
		end
	end

	-- MineralSpots 폴더만 탐색 (전체 workspace GetDescendants 회피)
	local function walk(root, depth)
		if not root or depth > 10 then
			return
		end
		for _, c in root:GetChildren() do
			if c.Name == "MineralSpots" then
				scanFolder(c)
			elseif c:IsA("Folder") or c:IsA("Model") then
				local n = string.lower(c.Name)
				if n:find("mineral", 1, true) or n:find("crystal", 1, true) or n:find("undercave", 1, true) or n:find("room", 1, true) or n == "rooms" then
					walk(c, depth + 1)
				elseif c:IsA("Folder") and depth < 4 then
					walk(c, depth + 1)
				end
			end
		end
	end
	walk(workspace, 0)

	for m in pairs(knownMinerals) do
		consider(m)
	end

	return best
end

