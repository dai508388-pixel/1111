local function ensureQuestEntry(questId)
	if type(questId) ~= "string" or questId == "" then
		return nil
	end
	local e = AutoFarm.questProgress[questId]
	if type(e) ~= "table" then
		e = { accepted = false, completed = false, progress = 0 }
		AutoFarm.questProgress[questId] = e
	end
	return e
end

local function markQuestAccepted(questId)
	local e = ensureQuestEntry(questId)
	if e then
		e.accepted = true
		e.completed = false
		e.progress = tonumber(e.progress) or 0
		e._localAt = os.clock()
	end
end

local function markQuestTurnedIn(questId)
	local e = ensureQuestEntry(questId)
	if e then
		e.accepted = true
		e.completed = true
		e._localAt = os.clock()
	end
end

local function questPhase(def)
	if type(def) ~= "table" or type(def.questId) ~= "string" then
		return "none"
	end
	local prereq = def.prerequisite
	if type(prereq) == "string" and prereq ~= "" then
		local pre = AutoFarm.questProgress[prereq]
		if not (pre and pre.completed == true) then
			return "unavailable_prerequisite"
		end
	end
	local prog = AutoFarm.questProgress[def.questId]
	local accepted = prog and prog.accepted == true
	if not accepted then
		return "offer"
	end
	if prog.completed == true then
		return "completed"
	end
	local need = def.condition and tonumber(def.condition.required) or 0
	if need <= (tonumber(prog.progress) or 0) then
		return "ready_to_turn_in"
	end
	return "in_progress"
end

