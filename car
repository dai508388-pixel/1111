-- 메인 퀘스트 중 수락/진행/반납 대상 고르기 (호감/일일 제외)
local function pickQuestFocus()
	local prio = {
		ready_to_turn_in = 1,
		in_progress = 2,
		offer = 3,
	}
	local tracked = LocalPlayer:GetAttribute("TrackedQuest")
	if type(tracked) == "string" and QuestDefs[tracked] then
		local def = QuestDefs[tracked]
		local phase = questPhase(def)
		if prio[phase] then
			return def, phase
		end
	end
	local best, bestPhase, bestPrio = nil, nil, 99
	for _, def in pairs(QuestDefs) do
		if type(def) == "table" and type(def.questId) == "string" then
			if def.questType ~= "sub" and type(def.repeatable) ~= "table" then
				local phase = questPhase(def)
				local pr = prio[phase]
				if pr and pr < bestPrio then
					best, bestPhase, bestPrio = def, phase, pr
				end
			end
		end
	end
	return best, bestPhase
end

local function tpNearNpc(npcKey)
	local hrp, hum = getChar()
	if not hrp then
		return false
	end
	if hum then
		AutoFarm.resetMovement(hum)
	end
	local model = findNpcModel(npcKey)
	if not model then
		-- 디폴트: village_elder 좌표 (NPCDefs)
		local def = NPCDefs[npcKey] or NPCDefs.village_elder
		if def and def.position then
			local p = def.position
			hrp.CFrame = CFrame.new(p.X + 3, (p.Y or 0) + 4, p.Z)
			return true
		end
		return false
	end
	local pivot = model:GetPivot()
	local raw = pivot.Position + pivot.RightVector * 3
	local stand = select(1, safeStandPos(raw, 3)) or (raw + Vector3.new(0, 3, 0))
	hrp.CFrame = CFrame.lookAt(stand, pivot.Position)
	return true
end

local HUNT_MOB_FAR = 180 -- 이보다 멀면 몹 위치로 즉시 TP (스폰 폴백용 거리)
local QUEST_SPAWN_TP_CD = 0.75

local function getMonsterDef(mobId)
	local def = MonsterDefs[mobId]
	if type(def) == "table" then
		return def
	end
	for id, d in pairs(MonsterDefs) do
		if type(d) == "table" and (d.monsterId == mobId or id == mobId) then
			return d
		end
	end
	return nil
end

-- SpawnPoint 태그/파츠 평균 (fallbackCenter는 물속에 찍히는 경우 많음)
local function collectSpawnPointPositions(mobId)
	local def = getMonsterDef(mobId)
	local tag = def and def.spawn and def.spawn.pointTag
	local positions = {}

	local function addPos(p)
		if typeof(p) == "Vector3" then
			table.insert(positions, p)
		end
	end

	local function addInst(inst)
		if not inst then
			return
		end
		if inst:IsA("BasePart") then
			addPos(inst.Position)
		elseif inst:IsA("Attachment") then
			addPos(inst.WorldPosition)
		elseif inst:IsA("Model") then
			addPos(inst:GetPivot().Position)
		else
			local part = inst:FindFirstChildWhichIsA("BasePart", true)
			if part then
				addPos(part.Position)
			end
		end
	end

	if type(tag) == "string" and tag ~= "" then
		pcall(function()
			for _, inst in CollectionService:GetTagged(tag) do
				addInst(inst)
			end
		end)
		-- 이름 폴백: SpawnPoints 폴더 + workspace 얕은 탐색
		for _, name in ipairs({ "SpawnPoints", "MonsterSpawns", "Spawns", "World" }) do
			local folder = workspace:FindFirstChild(name)
			if folder then
				for _, d in folder:GetDescendants() do
					if d.Name == tag or d.Name:lower() == tag:lower() then
						addInst(d)
					end
				end
			end
		end
		-- 태그 이름과 같은 인스턴스 (스트리밍된 스폰포인트)
		pcall(function()
			for _, d in workspace:GetDescendants() do
				if d.Name == tag then
					addInst(d)
					if #positions >= 8 then
						break
					end
				end
			end
		end)
	end

	return positions
end

local function averagePositions(list)
	if not list or #list < 1 then
		return nil
	end
	local sum = Vector3.zero
	for _, p in ipairs(list) do
		sum = sum + p
	end
	return sum / #list
end

-- 살아 있는 해당 몹 위치 (가장 정확)
local function findAnyAliveMobPos(mobId)
	local best, bestD = nil, math.huge
	local hrp = getChar()
	local origin = hrp and hrp.Position or Vector3.zero
	for _, m in iterMonsters() do
		if aliveMob(m) and m:GetAttribute(MONSTER_ATTR) == mobId then
			local root = getMobRoot(m)
			if root then
				local d = (root.Position - origin).Magnitude
				if d < bestD then
					best, bestD = root.Position, d
				end
			end
		end
	end
	return best
end

local function getMobSpawnAnchor(mobId)
	local live = findAnyAliveMobPos(mobId)
	if live then
		return live, "live"
	end
	local tagged = collectSpawnPointPositions(mobId)
	local avg = averagePositions(tagged)
	if avg then
		return avg, "tag"
	end
	local def = getMonsterDef(mobId)
	local center = def and def.spawn and def.spawn.fallbackCenter
	if typeof(center) == "Vector3" then
		return Vector3.new(center.X, center.Y, center.Z), "fallback"
	end
	return nil, nil
end

local function tpToMobSpawn(mobId, reason)
	if not AutoFarm.enabled then
		return false
	end
	local dest = select(1, getMobSpawnAnchor(mobId))
	if typeof(dest) ~= "Vector3" then
		return false
	end
	local now = os.clock()
	if now - AutoFarm.lastQuestSpawnTp < QUEST_SPAWN_TP_CD then
		return false
	end
	local hrp, hum = getChar()
	if not hrp then
		return false
	end
	AutoFarm.lastQuestSpawnTp = now
	if tpToSafePos(hrp, hum, dest, AutoFarm.hoverHeight) then
		AutoFarm.statusText = (reason or "스폰 TP") .. ": " .. mobDisplayName(mobId)
		return true
	end
	return false
end

local function pickHuntSpawnMobId()
	-- "전체"면 랜덤 스폰 TP 금지 (이상한 곳 텔레포트 원인)
	if AutoFarm.selectedMobs[MOB_ALL] or AutoFarm.selectedMobs.All then
		return nil
	end
	local chosen = {}
	for id in pairs(AutoFarm.selectedMobs) do
		if id ~= MOB_ALL and id ~= "All" then
			table.insert(chosen, id)
		end
	end
	if #chosen < 1 then
		return nil
	end
	table.sort(chosen)
	return chosen[1]
end

-- 선택 몹으로 TP: 살아 있는 개체 우선, 없으면 (특정 몹 선택 시에만) 스폰
function AutoFarm.tpToSelectedMob(reason)
	local hrp, hum = getChar()
	if not hrp then
		return false
	end
	local target = AutoFarm.findTarget(nil)
	if target then
		AutoFarm.bindTarget(target)
		AutoFarm.boundSelectionGen = AutoFarm.selectionGen
		AutoFarm.floatAbove(hrp, hum, target)
		local id = target:GetAttribute(MONSTER_ATTR) or target.Name
		AutoFarm.statusText = (reason or "mob TP") .. ": " .. tostring(id)
		return true
	end
	local mobId = pickHuntSpawnMobId()
	if mobId and tpToMobSpawn(mobId, reason or "선택 몹 스폰 TP") then
		task.delay(0.45, function()
			if not AutoFarm.enabled then
				return
			end
			local t2 = AutoFarm.findTarget(nil)
			if t2 then
				local h2, hum2 = getChar()
				AutoFarm.bindTarget(t2)
				if h2 then
					AutoFarm.floatAbove(h2, hum2, t2)
				end
			end
		end)
		return true
	end
	AutoFarm.statusText = "선택 몹 없음 (맵 로딩 대기)"
	return false
end

local function ensureHuntMobInRange(hrp, target)
	if hrp and target and isValidHuntTarget(target) then
		local root = getMobRoot(target)
		if root then
			if (root.Position - hrp.Position).Magnitude > 40 then
				tpToSafePos(hrp, select(2, getChar()), root.Position, AutoFarm.hoverHeight)
			end
			AutoFarm.floatAbove(hrp, select(2, getChar()), target)
			return target
		end
	end
	if not AutoFarm.enabled then
		return nil
	end
	local mobId = pickHuntSpawnMobId()
	if not mobId then
		return nil
	end
	local now = os.clock()
	if now - (AutoFarm.lastQuestSpawnTp or 0) < 1.0 then
		return nil
	end
	local live = findAnyAliveMobPos(mobId)
	if live then
		AutoFarm.lastQuestSpawnTp = now
		tpToSafePos(hrp, select(2, getChar()), live, AutoFarm.hoverHeight)
		return nil
	end
	tpToMobSpawn(mobId, "far spawn TP")
	return nil
end

