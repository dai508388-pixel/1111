local function jobDisplayName(jobId, fallback)
	local def = JobDefs[jobId]
	if def and type(def.nameKey) == "string" and Locale then
		local ok, name = pcall(function()
			return Locale.t(def.nameKey, Locale.clientLocale())
		end)
		if ok and type(name) == "string" and name ~= "" and name ~= def.nameKey then
			return name
		end
	end
	return fallback or jobId
end

local function npcDisplayName(npcKey)
	for _, row in ipairs(JOB_NPC_ORDER) do
		if row.key == npcKey then
			return jobDisplayName(row.jobId, row.label)
		end
	end
	local def = NPCDefs[npcKey]
	if def and type(def.jobId) == "string" then
		return jobDisplayName(def.jobId, npcKey)
	end
	return npcKey
end

local function getJobNpcEntries()
	local rows = {}
	for _, row in ipairs(JOB_NPC_ORDER) do
		local def = NPCDefs[row.key]
		if not def or def.role == "job_giver" then
			local order = row.order
			local jdef = JobDefs[row.jobId]
			if jdef and tonumber(jdef.uiOrder) then
				order = tonumber(jdef.uiOrder)
			end
			table.insert(rows, {
				key = row.key,
				jobId = row.jobId,
				label = jobDisplayName(row.jobId, row.label),
				order = order,
			})
		end
	end
	if #rows < 1 then
		for _, row in ipairs(JOB_NPC_ORDER) do
			table.insert(rows, {
				key = row.key,
				jobId = row.jobId,
				label = row.label,
				order = row.order,
			})
		end
	end
	table.sort(rows, function(a, b)
		if a.order == b.order then
			return a.label < b.label
		end
		return a.order < b.order
	end)
	return rows
end

