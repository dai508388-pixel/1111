-- [토글 이벤트 연결 - BOMB]
ToggleAll:OnChanged(function(value)
    if value then
        if ToggleExclude.Value then
            ToggleExclude:SetValue(false)
        end
        bombRunning = true
        startBombLoop()
    else
        if not ToggleExclude.Value then
            stopBombLoop()
        end
    end
end)

ToggleExclude:OnChanged(function(value)
    if value then
        if ToggleAll.Value then
            ToggleAll:SetValue(false)
        end
        bombRunning = true
        startBombLoop()
    else
        if not ToggleAll.Value then
            stopBombLoop()
        end
    end
end)

IntensitySlider:OnChanged(function()
    if bombRunning then
        startBombLoop()
    end
end)

-- [토글 이벤트 연결 - BLIND]
ToggleBlind:OnChanged(function(value)
    if value then
        blindRunning = true
        startBlindLoop()
    else
        stopBlindLoop()
    end
end)

BlindIntensitySlider:OnChanged(function()
