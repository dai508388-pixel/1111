-- [제외 여부 판별 함수]
local function isExcluded(player)
    local text = ExcludeInput.Value
    if text == "" then return false end
    
    local nameList = string.split(text, ",")
    local playerName = string.lower(player.Name)
    local displayName = string.lower(player.DisplayName)
    
    for _, name in ipairs(nameList) do
        local targetName = string.lower(string.gsub(name, "^%s*(.-)%s*$", "%1"))
        if targetName ~= "" then
            if string.find(playerName, targetName, 1, true) or string.find(displayName, targetName, 1, true) then
                return true
            end
        end
    end
    return false
end

-- [BOMB 실행 함수]
local function executeBomb()
    if not b then return end
    
    local allState = ToggleAll.Value
    local excludeState = ToggleExclude.Value
    
    local players = p:GetPlayers()
    
    for i = 1, #players do
        local v = players[i]
        if v ~= lp then
            if allState then
                b:FireServer(v)
            elseif excludeState then
                if not isExcluded(v) then
                    b:FireServer(v)
                end
            end
        end
    end
end

-- [BLIND 실행 함수]
local function executeBlind()
    if not blind then return end
    
    local players = p:GetPlayers()
    
    for i = 1, #players do
        local v = players[i]
        if v ~= lp then
            blind:FireServer(v)
        end
    end
end

-- [BOMB 메인 루프]
local bombRunning = false
local bombCoList = {}
local bombLoopActive = false
local bombRenderConnection = nil

local function startBombLoop()
    if bombLoopActive then
        stopBombLoop()
    end
    
    if not bombRunning then return end
    
    bombLoopActive = true
    local intensity = IntensitySlider.Value
    local count = math.min(intensity, 200000)
    
    bombRenderConnection = RunService.RenderStepped:Connect(function()
        if not bombRunning then return end
    end)
    
    local chunkSize = 5000
    local totalCreated = 0
    
    while totalCreated < count do
        local currentChunk = math.min(chunkSize, count - totalCreated)
        
        for i = 1, currentChunk do
            local co = coroutine.create(function()
                while bombRunning do
                    executeBomb()
                    task.wait()
                end
            end)
            table.insert(bombCoList, co)
            task.spawn(co)
            totalCreated = totalCreated + 1
        end
        
        task.wait(0.05)
    end
end

local function stopBombLoop()
    bombRunning = false
    bombLoopActive = false
    
    if bombRenderConnection then
        bombRenderConnection:Disconnect()
        bombRenderConnection = nil
    end
    
    for i = #bombCoList, 1, -1 do
        bombCoList[i] = nil
    end
    bombCoList = {}
end

