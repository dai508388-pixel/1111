-- ===================== Services & Vars =====================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local me = Players.LocalPlayer

local RANGE = 1000000

local isRunning = false
local connection = nil
local descendantConnection = nil

local selectKillRunning = false
local selectKillConnection = nil
local selectedNames = {}

local excludeKillRunning = false
local excludeKillConnection = nil
local excludeNames = {}

-- ===================== Sword Functions =====================
local function hasSword()
    local c = me.Character
    if c then
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and t:FindFirstChild("Handle") then
                return t
            end
        end
    end
    for _, t in ipairs(me.Backpack:GetChildren()) do
        if t:IsA("Tool") and t:FindFirstChild("Handle") then
            return t
        end
    end
    return nil
end

local function eat(tool)
    local ok, result = pcall(function()
        if not tool or not tool:IsA("Tool") then return false end
        local h = tool:FindFirstChild("Handle")
        local c = me.Character
        local root = c and c:FindFirstChild("HumanoidRootPart")
        if h and root then
            firetouchinterest(h, root, 0)
            firetouchinterest(h, root, 1)
            return true
        end
        return false
    end)
    return ok and result
end

local function parseNames(text)
    local names = {}
    if not text or text == "" then return names end
    for name in string.gmatch(text, "[^,]+") do
        name = name:match("^%s*(.-)%s*$")
        if name and name ~= "" then
            table.insert(names, name)
        end
    end
    return names
end

local function isExcluded(playerName)
    for _, name in ipairs(excludeNames) do
        if name:lower() == playerName:lower() then
            return true
        end
    end
    return false
end

-- ===================== 올킬 =====================
local function startAutoSword()
    if isRunning then return end
    isRunning = true

    descendantConnection = game.DescendantAdded:Connect(function(desc)
        if not isRunning then return end
        if desc:IsA("Tool") and desc:FindFirstChild("Handle") then
            task.spawn(eat, desc)
        end
    end)

    connection = RunService.Heartbeat:Connect(function()
        if not isRunning then return end

        if not hasSword() then
            for _, t in ipairs(workspace:GetChildren()) do
                if t:IsA("Tool") and t:FindFirstChild("Handle") then
                    eat(t)
                end
            end
            return
        end

        local tool = hasSword()
        if not tool then return end
        local h = tool:FindFirstChild("Handle")
        if not h then return end

        pcall(function() tool:Activate() end)

        for _, target in ipairs(Players:GetPlayers()) do
            if target ~= me and target.Character then
                local c = target.Character
                local hum = c:FindFirstChildOfClass("Humanoid")
                local root = c:FindFirstChild("HumanoidRootPart")

                if hum and hum.Health > 0 and root then
                    if me:DistanceFromCharacter(root.Position) <= RANGE then
                        for _, part in ipairs(c:GetChildren()) do
                            if part:IsA("BasePart") then
                                pcall(function()
                                    firetouchinterest(h, part, 0)
                                    firetouchinterest(h, part, 1)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end)

    Rayfield:Notify({Title = "올킬", Content = "올킬이 시작되었습니다", Duration = 3})
end

local function stopAutoSword()
    isRunning = false
    if connection then connection:Disconnect() connection = nil end
    if descendantConnection then descendantConnection:Disconnect() descendantConnection = nil end
    Rayfield:Notify({Title = "올킬", Content = "올킬이 중지되었습니다", Duration = 3})
end

-- ===================== Select Kill =====================
local function startSelectKill()
    if selectKillRunning then return end
    selectKillRunning = true

    selectKillConnection = RunService.Heartbeat:Connect(function()
        if not selectKillRunning then return end
        if #selectedNames == 0 then return end

        if not hasSword() then
            for _, t in ipairs(workspace:GetChildren()) do
                if t:IsA("Tool") and t:FindFirstChild("Handle") then
                    eat(t)
                end
            end
            return
        end

        local tool = hasSword()
        if not tool then return end
        local h = tool:FindFirstChild("Handle")
        if not h then return end

        pcall(function() tool:Activate() end)

        for _, name in ipairs(selectedNames) do
            local target = Players:FindFirstChild(name)
            if target and target ~= me and target.Character then
                local c = target.Character
                local hum = c:FindFirstChildOfClass("Humanoid")
                local root = c:FindFirstChild("HumanoidRootPart")

                if hum and hum.Health > 0 and root then
                    if me:DistanceFromCharacter(root.Position) <= RANGE then
                        for _, part in ipairs(c:GetChildren()) do
                            if part:IsA("BasePart") then
                                pcall(function()
                                    firetouchinterest(h, part, 0)
                                    firetouchinterest(h, part, 1)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end)

    Rayfield:Notify({Title = "Select Kill", Content = "입력한 닉네임 대상으로 킬 시작", Duration = 3})
end

local function stopSelectKill()
    selectKillRunning = false
    if selectKillConnection then
        selectKillConnection:Disconnect()
        selectKillConnection = nil
    end
    Rayfield:Notify({Title = "Select Kill", Content = "Select Kill 중지됨", Duration = 3})
end

-- ===================== Kill All (제외) =====================
local function startExcludeKill()
    if excludeKillRunning then return end
    excludeKillRunning = true

    excludeKillConnection = RunService.Heartbeat:Connect(function()
        if not excludeKillRunning then return end

        if not hasSword() then
            for _, t in ipairs(workspace:GetChildren()) do
                if t:IsA("Tool") and t:FindFirstChild("Handle") then
                    eat(t)
                end
            end
            return
        end

        local tool = hasSword()
        if not tool then return end
        local h = tool:FindFirstChild("Handle")
        if not h then return end

        pcall(function() tool:Activate() end)

        for _, target in ipairs(Players:GetPlayers()) do
            if target ~= me and target.Character and not isExcluded(target.Name) then
                local c = target.Character
                local hum = c:FindFirstChildOfClass("Humanoid")
                local root = c:FindFirstChild("HumanoidRootPart")

                if hum and hum.Health > 0 and root then
                    if me:DistanceFromCharacter(root.Position) <= RANGE then
                        for _, part in ipairs(c:GetChildren()) do
                            if part:IsA("BasePart") then
                                pcall(function()
                                    firetouchinterest(h, part, 0)
                                    firetouchinterest(h, part, 1)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end)

    Rayfield:Notify({Title = "Kill All (제외)", Content = "제외한 사람 빼고 올킬 시작", Duration = 3})
end

local function stopExcludeKill()
    excludeKillRunning = false
    if excludeKillConnection then
        excludeKillConnection:Disconnect()
        excludeKillConnection = nil
    end
    Rayfield:Notify({Title = "Kill All (제외)", Content = "Kill All (제외) 중지됨", Duration = 3})
end

