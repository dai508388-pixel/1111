local function safeFindScrollFrame()
    local found = nil
    
    pcall(function()
        local playerGui = player:FindFirstChild("PlayerGui")
        if not playerGui then return end
        
        local hdAdmin = playerGui:FindFirstChild("HDAdminInterface") or playerGui:FindFirstChild("Admin")
        if not hdAdmin then 
            hdAdminExists = false
            updateStatus("❌ HDAdmin 없음")
            return 
        end
        
        hdAdminExists = true
        updateStatus("✅ HDAdmin 있음")
        
        local commandMenu = hdAdmin:FindFirstChild("CommandMenucommandLogs")
        if commandMenu then
            pcall(function()
                commandMenu.Visible = false
            end)
            
            local mainFrame = commandMenu:FindFirstChild("MainFrame")
            if mainFrame then
                local scroll = mainFrame:FindFirstChild("ScrollFrame")
                if scroll then
                    found = scroll
                end
            end
        end
    end)
    
    return found
