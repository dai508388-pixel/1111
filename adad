-- ========== 8. 로그 검사 ==========
local function checkAllLogs()
    local found = false
    local foundType = nil
    
    pcall(function()
        if not scrollFrame or not scrollFrame.Parent then
            return
        end
        
        local playerName = player.Name
        local lowerPlayer = string.lower(playerName)
        
        local keywords = {
            "permban",
            "directban all",
            "directban",
            "serverlock",
            "crash all",
            "shutdown",
            "crash others",
            "crash other",
            "directban others",
            "directban other",
            "kick"
        }
        
        for _, child in ipairs(scrollFrame:GetChildren()) do
            if child:IsA("Frame") then
                for _, subChild in ipairs(child:GetChildren()) do
                    if subChild:IsA("TextLabel") then
                        local text = subChild.Text or ""
                        local lowerText = string.lower(text)
                        
                        if string.find(lowerText, lowerPlayer) then
                            for _, kw in ipairs(keywords) do
                                if string.find(lowerText, kw) then
                                    found = true
                                    foundType = kw
                                    return
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
    
    return found, foundType
end

