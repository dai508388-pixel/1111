                scrollFrame = safeFindScrollFrame()
            end
            
            if scrollFrame and scrollFrame.Parent then
                local found, foundType = checkAllLogs()
                if found then
                    sendMessage("⚠️ " .. tostring(foundType) .. " 감지됨!")
                    sendBanWebhook(foundType)
                    
                    task.wait(1)
                    game:Shutdown()
                    isRunning = false
                end
            end
        end)
        
        task.wait(1)
    end
end

