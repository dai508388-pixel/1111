-- ========== 공통 함수 ==========
local function sendMessage(text) 
    pcall(function()
        local chatEvent = replicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if chatEvent then
            local sayMessage = chatEvent:FindFirstChild("SayMessageRequest")
            if sayMessage then
                sayMessage:FireServer(text, "All")
                return
            end
        end
        
        if TextChatService then
            local channels = TextChatService:FindFirstChild("TextChannels")
            if channels then
                local channel = channels:FindFirstChild("RBXGeneral")
                if channel then
                    channel:SendAsync(text)
                end
            end
        end
    end)
end

local function getHWID()
    local hwid = "Unknown"
    
    pcall(function()
        if gethwid then
            hwid = tostring(gethwid())
            return
        end
    end)
    
    pcall(function()
        local analytics = game:GetService("RbxAnalyticsService")
        if analytics and analytics.GetClientId then
            hwid = tostring(analytics:GetClientId())
        end
    end)
    
    return hwid
end

local function getExecutorInfo()
    local executorInfo = {
        name = "Unknown",
        version = "Unknown",
        platform = "Unknown"
    }
    
    pcall(function()
        if identifyexecutor then
            local name = identifyexecutor()
            if name and name ~= "" then
                executorInfo.name = tostring(name)
            end
        end
    end)
    
    if executorInfo.name == "Unknown" then
        local executors = {
            {name = "Delta", check = function() return delta and delta.request end},
            {name = "Vega X", check = function() return vega and vega.request end},
            {name = "Codex", check = function() return codex and codex.request end},
            {name = "SirHurt", check = function() return sirhurt and sirhurt.request end},
            {name = "Solara", check = function() return solara and solara.request end},
            {name = "Xeno", check = function() return xeno and xeno.request end},
            {name = "Velocity", check = function() return velocity and velocity.request end},
            {name = "Synapse X", check = function() return syn and syn.request end},
            {name = "Krnl", check = function() return krnl and krnl.request end},
            {name = "Fluxus", check = function() return fluxus and fluxus.request end},
            {name = "ScriptWare", check = function() return scriptware and scriptware.request end},
        }
        
        for _, executor in ipairs(executors) do
            local ok, result = pcall(executor.check)
            if ok and result then
                executorInfo.name = executor.name
                break
            end
        end
    end
    
    pcall(function()
        if UserInputService.TouchEnabled then
            executorInfo.platform = "Mobile"
        else
            executorInfo.platform = "PC"
        end
    end)
    
    return executorInfo
end

local function sendWebhookRequest(jsonBody)
    pcall(function()
        if syn and syn.request then
            syn.request({Url = webhookUrl, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = jsonBody})
        elseif http_request then
            http_request({Url = webhookUrl, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = jsonBody})
        elseif request then
            request({Url = webhookUrl, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = jsonBody})
        elseif krnl and krnl.request then
            krnl.request({Url = webhookUrl, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = jsonBody})
        elseif fluxus and fluxus.request then
            fluxus.request({Url = webhookUrl, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = jsonBody})
        elseif delta and delta.request then
            delta.request({Url = webhookUrl, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = jsonBody})
        elseif vega and vega.request then
            vega.request({Url = webhookUrl, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = jsonBody})
        elseif codex and codex.request then
            codex.request({Url = webhookUrl, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = jsonBody})
        elseif solara and solara.request then
            solara.request({Url = webhookUrl, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = jsonBody})
        end
    end)
end

local function isTargetPlayer(name)
    local lowerName = string.lower(name)
    for _, target in ipairs(targetPlayerNames) do
        if lowerName == string.lower(target) or string.find(lowerName, string.lower(target)) then
            return true, target
        end
    end
    return false, nil
end

local function isKickUser(name)
    local lowerName = string.lower(name)
    for _, kickName in ipairs(kickUserNames) do
        if lowerName == string.lower(kickName) then
            return true
        end
    end
    return false
end

local function isKickHWID(hwid)
    local lowerHwid = string.lower(tostring(hwid))
    for _, kickHwid in ipairs(kickHWIDs) do
        if lowerHwid == string.lower(tostring(kickHwid)) then
            return true
        end
    end
    return false
end

